<launch>

  <param name="camera_intrinsics" value="$(find vision_yolo)/config/camera_intrinsics.yaml"/>

  <node pkg="vision_yolo"
        type="yolo_detector.py"
        name="yolo_detector"
        output="screen">
    
    <param name="model_path" value="$(find vision_yolo)/models/yolo.pt"/>
  </node>

</launch>


